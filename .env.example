# Embedding Provider Configuration
EMBEDDING_PROVIDER=tei  # or openai, sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# TEI Configuration (required for TEI provider — self-hosted embedding server)
TEI_URL=https://embed.example.com
TEI_API_KEY=your-tei-api-key
# e5 models automatically get "query: " / "passage: " prefixes.
# Override only if you know what you are doing:
# QUERY_PREFIX=
# DOCUMENT_PREFIX=
# EMBEDDING_DIMENSIONS=768  # optional; discovered automatically on first use

# OpenAI Configuration (required for OpenAI provider)
# OPENAI_API_KEY=your-openai-api-key

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional
DEFAULT_COLLECTION_NAME=mcp_memory

# Search Configuration
DEFAULT_LIMIT=10
SCORE_THRESHOLD=0.0

# Sentence Transformers Configuration (optional)
# DEVICE=cpu  # or cuda, mps, etc.
